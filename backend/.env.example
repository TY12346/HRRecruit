# Django core
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
DJANGO_ALLOW_DEBUG_HOSTS=True
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
POSTGRES_DB=hrrecruit_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Password reset links
FRONTEND_PASSWORD_RESET_URL=http://localhost:5173/reset-password

# Local development default: prints emails in the Django server console.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=no-reply@hrrecruit.local

# To receive real emails in an inbox, use SMTP settings like these.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your-smtp-username@example.com
# EMAIL_HOST_PASSWORD=your-smtp-app-password
# EMAIL_USE_TLS=True
# EMAIL_USE_SSL=False
# EMAIL_TIMEOUT=10
# DEFAULT_FROM_EMAIL=your-smtp-username@example.com

# Firebase Cloud Messaging push notifications for the Flutter mobile app.
FIREBASE_PUSH_ENABLED=False
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
FIREBASE_CREDENTIALS_JSON=
FIREBASE_USE_APPLICATION_DEFAULT_CREDENTIALS=False

# Google Calendar API OAuth/event sync for interview scheduling.
GOOGLE_CALENDAR_ENABLED=False
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:5173/recruiter/calendar/google/callback
GOOGLE_CALENDAR_DEFAULT_DURATION_MINUTES=60
GOOGLE_CALENDAR_OAUTH_STATE_MAX_AGE_SECONDS=1800

# Transcription can run locally with openai-whisper; no OpenAI/Google ASR API is required.
TRANSCRIPTION_PROVIDER=local_whisper
TRANSCRIPTION_MODEL=small
USE_REAL_TRANSCRIPTION=True
# Optional local speaker diarization. Keep False unless pyannote.audio is installed
# and the Hugging Face account/token has accepted access for the configured
# pyannote model and any gated pyannote model files it downloads.
USE_SPEAKER_DIARIZATION=False
# Set True only when you want transcript generation to fail unless diarization completes.
REQUIRE_SPEAKER_DIARIZATION=False
PYANNOTE_AUTH_TOKEN=
DIARIZATION_MODEL=pyannote/speaker-diarization-3.1
# OpenAI key is only needed when TRANSCRIPTION_PROVIDER=openai or SUMMARY_PROVIDER=openai.
OPENAI_API_KEY=
# Interview AI summaries can use mock mode, OpenAI, or Google Gemini.
USE_REAL_SUMMARY=True
SUMMARY_PROVIDER=gemini
GEMINI_API_KEY=
SUMMARY_MODEL=gemini-3.5-flash
# Strict real-AI policy: failures are recorded and shown; no generated fallback output is permitted.
STRICT_REAL_AI=True
ALLOW_MOCK_AI=False
# Whisper model options: tiny, base, small, medium, large. Smaller real models transcribe faster.
WHISPER_MODEL_SIZE=small
# Keep converted PCM WAV files locally for manual development inspection only.
PRESERVE_PREPROCESSED_AUDIO=False
# Runs real pyannote diarization when True; failures are returned as diarization failed/unavailable.
ENABLE_SPEAKER_DIARIZATION=False

# Stripe Checkout test mode. Never commit real keys. The webhook secret comes
# from `stripe listen` locally or the test-mode webhook endpoint in Dashboard.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CHECKOUT_SUCCESS_URL=http://localhost:5173/hiring-manager/onboarding/payment-return?checkout=success&session_id={CHECKOUT_SESSION_ID}
STRIPE_CHECKOUT_CANCEL_URL=http://localhost:5173/hiring-manager/onboarding/payment-return?checkout=cancelled
STRIPE_CURRENCY=MYR
