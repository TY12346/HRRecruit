# Backend ignore rules.
# Ignore only generated files, local secrets, local media, and local tooling state.
# Do not ignore Django apps, migrations, fixtures, docs, tests, or required ML artifacts.

# Python caches / compiled output
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.sqlite3

# Virtual environments
.venv/
venv/
env/

# Django generated/local runtime files
*.log
staticfiles/
media/
!media/
!media/.gitkeep

# Local environment secrets. Keep sample env files versioned.
.env
!.env.example

# Tooling/editor state
.pytest_cache/
.mypy_cache/
.vscode/
.idea/
