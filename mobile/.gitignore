# Flutter mobile ignore rules.
# Ignore generated Flutter/Dart outputs and editor state only.
# Do not ignore lib/, test/, pubspec.yaml, pubspec.lock, assets, or platform source files.

.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android Studio / IntelliJ local state
*.iml
.idea/

# VS Code local state
.vscode/
